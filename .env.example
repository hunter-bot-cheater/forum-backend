# docker compose 读取的变量。复制为 .env 后填真实值，.env 已被 .gitignore 忽略。
#
# 生成随机密码：openssl rand -hex 16
# JWT_SECRET 必须 32 个字符以上，公开的占位值会被服务端直接拒绝启动。

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PASSWORD=change_me_forum

REDIS_PASSWORD=change_me_redis

JWT_SECRET=change_me_at_least_32_chars_long_random_string

# 大模型自动标签。不填就整条链路关闭，发布接口不会发外部请求。
LLM_ENABLED=false
LLM_API_KEY=

# ---------- 以下是生产部署（deploy/prod/）才用到的变量 ----------

# 生产 Nginx 用哪份配置。
#   首次申请证书：nginx.http.conf（纯 HTTP，站点可用，还没有证书）
#   拿到证书之后：nginx.conf（80 跳转 + 443）
# 改完执行 docker compose ... restart web 生效。本机开发不需要这个变量。
NGINX_CONF=nginx.conf

# 「本机编译、服务器只打镜像」方式的镜像标签（见 docs/10 第 13.5 节）。
# 格式是「月日-时分-commit短哈希」，例如 1118-0228-7d2ac1f，由 scripts/pack-linux.sh
# 打包时写好放在 .build/IMAGE_TAG，服务器上 $(cat .build/IMAGE_TAG) 抄进这里。
# 本机开发用不到这一项；这一行必须真实存在，注释掉或删掉会退回默认值 local，
# 所有版本同名，回退时无版可选。
IMAGE_TAG=local
