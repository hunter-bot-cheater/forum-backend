# docker compose 读取的变量。复制为 .env 后填真实值，.env 已被 .gitignore 忽略。
#
# 生成随机密码：openssl rand -hex 16
# JWT_SECRET 必须 32 个字符以上，公开的占位值会被服务端直接拒绝启动。

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PASSWORD=change_me_forum

REDIS_PASSWORD=change_me_redis

JWT_SECRET=change_me_at_least_32_chars_long_random_string

# 大模型自动标签。不填就整条链路关闭，发布接口不会发外部请求。
LLM_ENABLED=false
LLM_API_KEY=
