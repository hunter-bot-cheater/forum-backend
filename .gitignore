# ============ 依赖与构建产物 ============
# Go 编译产物
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# 前端依赖与构建产物（web/ 是独立的 Vue 工程）
web/node_modules/
web/dist/
web/dist-prod/
web/.env
web/.env.local
web/*.log
# vite 启动时写的配置时间戳缓存，正常退出会自己删；
# 进程被强杀时会留下，别让它进仓库。
web/vite.config.ts.timestamp-*

# 调试/临时构建目录
dist_probe/
tmp/

# 覆盖率
coverage.out

# Go vendor（若使用 go mod vendor）
/vendor/

# ============ 密钥与本地配置（含敏感信息，禁止提交） ============
# 真实配置含 MySQL / Redis 密码与 JWT 密钥，已在本地忽略，不会上传到 GitHub。
# 仓库只保留 config/config.example.yaml 作为模板：
#   克隆后把它复制成 config/config.yaml，填你自己的密码；
#   或者按 internal/config/config.go 的 BindEnv，用环境变量覆盖
#   （MYSQL_PASSWORD / REDIS_PASSWORD / JWT_SECRET）。
.env
.env.local
config/config.yaml
config/config.local.yaml
config/.env

# ============ 编辑器与 IDE ============
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# ============ 操作系统 ============
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ============ 日志 ============
*.log
logs/

# ============ 用户上传的图片 ============
# 头像是运行时数据，不是代码；进仓库只会让仓库越滚越大，且泄露用户内容。
uploads/

# ============ 本机打包产物 ============
# scripts/pack-linux.sh 把 Linux 二进制与前端 dist 放在这里，
# 它们是构建结果，随打随删，不进仓库。
.build/

# ============ 备份产物 ============
# 数据库 dump 里有全站用户与文章，绝不入库。
backups/

# ============ 生产证书 ============
# certbot 申请到的私钥与账号信息，泄露等于别人能冒充你的站点。
certbot/

# ============ 测试产物 ============
# go test -coverprofile 的输出，只在本地临时看覆盖率，不该进仓库。
coverage.out
c.out

# ============ pool-sim（Python 物理服务）============
# 字节码与 pytest 缓存都带本机绝对路径，进仓库既没用又会天天制造 diff。
__pycache__/
*.pyc
.pytest_cache/
