# 2C2G 机器上的 MySQL 参数。挂到容器的 /etc/mysql/conf.d/forum.cnf，
# 官方的 mysql:8.0 镜像会自动读 conf.d 下的 *.cnf，不需要改启动命令。
#
# 目标只有一个：让 MySQL 的常驻内存从「默认的 500MB+」降到 300MB 左右，
# 给 Go 服务、nginx 和系统留出余量。参数都按「够用即可」挑，不做性能调优。

[mysqld]

# 缓冲池是 MySQL 最大的一块可控内存，默认 128M。
# 这里不再往上加：论坛的文章表在几万行量级，128M 足够把热点页全装进来，
# 再加只会挤压别的进程。真要提速，先看慢查询，而不是先把这块调大。
innodb_buffer_pool_size = 128M

# 性能采集默认开着，自己就要吃掉一两百 MB。这个量级的站点用不上
# information_schema 里的那些统计视图，关掉换内存。
# 代价：排查锁等待时看不到 performance_schema 的表，只能靠 SHOW PROCESSLIST。
performance_schema = OFF

# 连接数上限。每个连接都有自己的排序缓冲、临时表缓冲，
# 上限开太大，突发流量下内存会被连接数乘起来吃光。
# 后端连接池最大 20 条（见 internal/config/db.go 的 SetMaxOpenConns），
# 50 是给它留一倍余量，再算上备份、手工排查时连进去的那一两条。
max_connections = 50

# 应用层已经按 slow_query_ms 打了带 request_id 的慢查询日志，
# MySQL 自己再记一份只是重复，而且没有请求上下文，对不上是哪次请求。
slow_query_log = OFF

# 连接断开后立即回收临时表空间，小磁盘上能省一点。
# 默认值在 8.0 里已经很小，这里只是显式写出来。
innodb_temp_data_file_path = ibtmp1:12M:autoextend
