# 前端运行镜像（预编译版）：只把本机构建好的 dist 拷进 nginx。
#
# 与 deploy/web.Dockerfile 的区别：那边从 node 镜像跑 npm ci + vite build，
# 这边直接用 scripts/pack-linux.sh 产出的静态文件。
#
# 构建上下文是 .build/web（见 deploy/prod/docker-compose.artifact.yml）。
# scripts/pack-linux.sh 会把这份文件复制成 .build/web/Dockerfile，
# 所以下面的 COPY 路径都相对于那个目录。
FROM nginx:1.27-alpine

COPY default.conf /etc/nginx/conf.d/default.conf
COPY dist /usr/share/nginx/html

EXPOSE 80
